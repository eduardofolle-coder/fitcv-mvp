        {
          "name": "Suggest Roles",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.length > 0) {",
                  "        pm.environment.set('roleId', jsonData.data[0].id);",
                  "    }",
                  "}"
                ]
              }
