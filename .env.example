# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=sqlite://./data/fitcv.db

# JWT
JWT_PRIVATE_KEY=your-private-key-here
JWT_PUBLIC_KEY=your-public-key-here
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption
DATA_ENCRYPTION_KEY=your-32-byte-encryption-key-here

# Claude API
CLAUDE_API_KEY=your-claude-api-key-here

# CORS
ALLOWED_ORIGINS=http://localhost:3001,https://fitcv.app

# DeepSeek Fallback
DEEPSEEK_API_KEY=your-deepseek-key-here

# Logging
LOG_LEVEL=info
