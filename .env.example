# Backend Configuration
NODE_ENV=production
PORT=3000

# JWT Secrets (change in production!)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key

# Encryption Key (exactly 32 characters for AES-256)
ENCRYPTION_KEY=your-32-character-encryption-key

# Claude API (get from console.anthropic.com)
CLAUDE_API_KEY=sk-ant-your-actual-api-key

# CORS allowed origins
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000,https://fitcv.example.com

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
