# Backend Configuration
NODE_ENV=production
PORT=3000

# Base de datos
#   Producción: un PostgreSQL real.
#   Desarrollo: pglite://<ruta> corre el mismo PostgreSQL en proceso, sin instalar nada.
#   Tests:      memory://
DATABASE_URL=postgres://user:password@host:5432/fitcv

# Secretos. En producción el servidor se niega a arrancar si quedan en el valor
# de desarrollo o miden menos de 32 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_PRIVATE_KEY=replace-me-with-32-plus-random-characters
JWT_PUBLIC_KEY=replace-me-with-32-plus-random-characters
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Clave de cifrado en reposo (AES-256). Cambiarla vuelve ilegibles los CVs ya guardados.
DATA_ENCRYPTION_KEY=replace-me-with-32-plus-random-characters

# Claude API (console.anthropic.com). Sin una clave válida fallan el análisis
# de CV, el ranking y la adaptación.
CLAUDE_API_KEY=sk-ant-your-actual-api-key

# Modelos. Los identificadores caducan: cuando Anthropic retire uno, la API
# responde "model: ..." aunque la clave sea válida. Se cambian aquí, sin tocar
# código.
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_ORCHESTRATOR_MODEL=claude-opus-5

# Rankear ofertas o reescribir un CV completo puede pasar del minuto.
CLAUDE_TIMEOUT_MS=120000

# Dirección pública de la web (para los enlaces de los correos).
APP_URL=https://fitcv.cl

# Correo transaccional con Resend (recuperar contraseña). Sin estas dos no se
# envían correos. EMAIL_FROM debe ser de un dominio verificado en Resend.
RESEND_API_KEY=
EMAIL_FROM=FITCV <no-reply@fitcv.cl>

# Cada cuántos minutos leer los portales de empleo. 0 = apagado.
OFFER_SYNC_MINUTES=60

# Con varias instancias del backend, solo una corre las tareas programadas;
# en las demás poner false.
RUN_SCHEDULERS=true

# Reporte de errores (sentry.io). Si se omite, no se reporta nada y la app
# arranca igual.
SENTRY_DSN=
RELEASE_VERSION=

# CORS: orígenes del frontend
ALLOWED_ORIGINS=https://fitcv.cl,https://www.fitcv.cl

# Logging
LOG_LEVEL=info
