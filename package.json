{
  "name": "fitcv-mvp",
  "version": "0.2.0",
  "description": "FITCV - CV autoadaptado por oferta laboral con IA",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node fix-esm.cjs",
    "start": "node dist/server.js",
    "db:init": "tsx src/db/init.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "npm run build && vitest run tests --reporter=verbose",
    "test:watch": "vitest tests",
    "test:integration": "vitest run tests/integration --reporter=verbose 2>/dev/null || echo 'Integration tests not configured'",
    "test:security": "npm audit --audit-level=moderate 2>/dev/null || echo 'Audit skipped'",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run test",
    "pre-commit": "node .claude/hooks/pre-commit.js",
    "pre-push": "node .claude/hooks/pre-push.js"
  },
  "keywords": [
    "job",
    "cv",
    "ai",
    "latam"
  ],
  "author": "Eduardo Folle",
  "license": "MIT",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@sentry/node": "^10.74.0",
    "@types/pg": "^8.23.1",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "pg": "^8.23.0",
    "sqlite": "^5.1.1",
    "uuid": "11.1.1",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.3.1",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "eslint": "^8.44.0",
    "tsx": "^3.12.7",
    "typescript": "^5.1.3",
    "vitest": "^0.34.0"
  }
}
